Options -MultiViews
DirectoryIndex index.php index.html
RewriteEngine On

# --- Segurança: bloquear acesso direto a arquivos sensíveis ---
<FilesMatch "(^\.env$|\.env\..*|\.sql$|\.secret$|\.md$|composer\.(json|lock)$|config\.local\.php$|config\.local\.example\.php$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Bloquear pastas internas sem depender do nome usado na URL pública
RewriteRule ^(?:database|storage)(?:/|$) - [F,L,NC]
RewriteRule ^vendor/.*\.php$ - [F,L,NC]

# --- Cabeçalhos de segurança ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), geolocation=(), microphone=()"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# --- Roteamento SPA: arquivos/pastas reais são servidos; o resto vai ao index.php ---
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L]
